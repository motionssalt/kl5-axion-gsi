# Fingerprint HAL binding & sensor node setup for Tecno KL5 (Goodix / Focaltech / FPSensor)
on early-boot
    chmod 0666 /dev/goodix_fp
    chown system system /dev/goodix_fp
    chmod 0666 /dev/fpsensor
    chown system system /dev/fpsensor
    chmod 0666 /dev/focaltech_fp
    chown system system /dev/focaltech_fp
    chmod 0666 /dev/teei_fp
    chown system system /dev/teei_fp
    chmod 0666 /dev/kfp
    chown system system /dev/kfp

on post-fs-data
    mkdir /data/vendor/goodix 0777 system system
    mkdir /data/vendor/goodix/gf_data 0777 system system
    mkdir /data/vendor/tran_fp 0777 system system
    mkdir /data/vendor/focaltech 0777 system system
    mkdir /data/vendor/fpdump 0777 system system

on boot
    setprop ro.hardware.fingerprint tecno
    start vendor.fps_hal
